{
  "name": "magfdm-visualizer",
  "version": "1.7.1",
  "description": "Web UI for MagFDMsolver visualization",
  "main": "server.js",
  "bin": "launcher.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node launcher.js",
    "dev": "node launcher.js",
    "test": "node --test tests/*.test.js",
    "package": "pkg package.json"
  },
  "keywords": [
    "magnetic-field",
    "visualization",
    "FDM"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "zod": "4.6.7",
    "image-size": "2.0.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "express": "^4.21.2",
    "jimp": "^0.22.12",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.23.0"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "automation/**/*.js",
      "public/workspace-core.js",
      "public/yaml-intellisense.js",
      "node_modules/@modelcontextprotocol/server/dist/**/*.cjs",
      "node_modules/@modelcontextprotocol/client/dist/**/*.cjs"
    ],
    "assets": [
      "public/yaml-schema.json"
    ]
  }
}
