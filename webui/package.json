{
  "name": "magfdm-visualizer",
  "version": "1.7.3",
  "description": "Web UI for MagFDMsolver visualization",
  "main": "server.js",
  "bin": "launcher.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "start": "node launcher.js",
    "dev": "node launcher.js",
    "test": "node --test tests/*.test.js",
    "package": "node tools/build-mcp-package.cjs"
  },
  "keywords": [
    "magnetic-field",
    "visualization",
    "FDM"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "8.7.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^4.21.2",
    "image-size": "2.0.4",
    "jimp": "1.6.1",
    "js-yaml": "^4.1.0",
    "multer": "2.5.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.23.0",
    "node-pty": "1.1.0"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "automation/**/*.js",
      "public/workspace-core.js",
      "public/yaml-intellisense.js",
      "node_modules/@modelcontextprotocol/server/dist/**/*.cjs",
      "node_modules/@modelcontextprotocol/client/dist/**/*.cjs",
      "node_modules/@jimp/**/*.js"
    ],
    "assets": [
      "public/yaml-schema.json"
    ]
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
